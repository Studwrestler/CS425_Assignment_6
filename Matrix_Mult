                                                                                                                                                                                                                                                                                                                                                                   Matrix_Mult.c                                                                                                                                                                                                                                                                                                                                                                                   #include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <time.h>
#include <math.h>

#define N 1000
#define NUM_THREADS 6

double *A, *B, *B_trans, *C;

typedef struct {
    int start_row;
    int end_row;
} ThreadData;

void generate_matrix(double *matrix) {
    for (int i = 0; i < N * N; i++)
        matrix[i] = (double)rand() / RAND_MAX * 10.0;
}

void transpose_matrix(double *src, double *dest) {
    for (int i = 0; i < N; i++)
        for (int j = 0; j < N; j++)
            dest[j * N + i] = src[i * N + j];
}

void* matrix_mult_thread(void* arg) {
    ThreadData* data = (ThreadData*)arg;
    for (int i = data->start_row; i < data->end_row; i++) {
        for (int j = 0; j < N; j++) {
            double sum = 0.0;
            for (int k = 0; k < N; k++) {
                sum += A[i * N + k] * B_trans[j * N + k];  // Use transposed B
            }
            C[i * N + j] = sum;
        }
    }
    return NULL;
}

void serial_matrix_mult(double *result) {
    for (int i = 0; i < N; i++)
        for (int j = 0; j < N; j++) {
            double sum = 0.0;
            for (int k = 0; k < N; k++)
                sum += A[i * N + k] * B_trans[j * N + k];  // Also use transposed B here
            result[i * N + j] = sum;
        }
}

double get_time_sec() {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec + ts.tv_nsec / 1e9;
}

int main() {
    pthread_t threads[NUM_THREADS];
    ThreadData thread_data[NUM_THREADS];

    A = malloc(N * N * sizeof(double));
    B = malloc(N * N * sizeof(double));
    B_trans = malloc(N * N * sizeof(double));
    C = malloc(N * N * sizeof(double));
    double *serial_C = malloc(N * N * sizeof(double));

    srand(time(NULL));
    generate_matrix(A);
    generate_matrix(B);
    transpose_matrix(B, B_trans);

    int rows_per_thread = N / NUM_THREADS;

    double parallel_start = get_time_sec();

    for (int i = 0; i < NUM_THREADS; i++) {
        thread_data[i].start_row = i * rows_per_thread;
        thread_data[i].end_row = (i == NUM_THREADS - 1) ? N : (i + 1) * rows_per_thread;
        pthread_create(&threads[i], NULL, matrix_mult_thread, &thread_data[i]);
    }

    for (int i = 0; i < NUM_THREADS; i++) {
        pthread_join(threads[i], NULL);
    }

    double parallel_end = get_time_sec();
    double parallel_time = parallel_end - parallel_start;

    double serial_start = get_time_sec();
    serial_matrix_mult(serial_C);
    double serial_end = get_time_sec();
    double serial_time = serial_end - serial_start;

    // Compare results
    int correct = 1;
    for (int i = 0; i < N * N; i++) {
        if (fabs(C[i] - serial_C[i]) > 1e-6) {
            correct = 0;
            break;
        }
    }

    printf("Serial Time   : %f seconds\n", serial_time);
    printf("Parallel Time : %f seconds\n", parallel_time);
    printf("Speedup       : %f\n", serial_time / parallel_time);
    printf("Correctness   : %s\n", correct ? "Correct" : "Incorrect");

    free(A);
    free(B);
    free(B_trans);
    free(C);
    free(serial_C);

    return 0;
}



























